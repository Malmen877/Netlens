set version 23.4R2-S2
set system host-name core-ex1
set system login user netops class super-user
set system login user netops authentication encrypted-password "$6$Zx9Yw8Vu$aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789abcdefghijklmn"
set system services ssh root-login deny
set system ntp server 10.10.10.124
set interfaces ge-0/0/10 description "to access-sw7"
set interfaces ge-0/0/10 unit 0 family ethernet-switching interface-mode trunk
set interfaces ge-0/0/10 unit 0 family ethernet-switching vlan members [ USERS VOICE ]
set interfaces ge-0/0/11 description "spare"
set interfaces irb unit 10 family inet address 10.20.10.1/24
set interfaces irb unit 20 family inet address 10.20.20.1/24
set vlans USERS vlan-id 10
set vlans USERS l3-interface irb.10
set vlans VOICE vlan-id 20
set vlans VOICE l3-interface irb.20
set vlans PRINTERS vlan-id 30
set routing-options static route 10.99.0.0/16 next-hop 10.20.0.5
set protocols ospf area 0.0.0.0 interface irb.10 passive
set protocols ospf area 0.0.0.0 interface irb.20 passive
